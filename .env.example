# ============================================================
# SentinelX environment variables
# Copy to .env and adjust for your environment.
# NEVER commit the real .env file.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sentinelx

# --- Backend ---
# SQLAlchemy connection URL
DATABASE_URL=postgresql+psycopg://sentinelx:change_me@127.0.0.1:5432/sentinelx

# JWT signing secret — MUST be replaced with a long random value in production
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=please-change-me-with-a-long-random-secret

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

APP_ENV=development
DEBUG=false

# JWT lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Login brute-force protection: max attempts per window per IP.
# Disable with an empty value or "0/minute".
LOGIN_RATE_LIMIT=10/minute

# Registration brute-force protection: max registrations per window per IP.
REGISTER_RATE_LIMIT=10/hour

# Per-account login brute-force cap (survives distributed brute force).
LOGIN_ACCOUNT_RATE_LIMIT=30/minute

# IPs whose X-Forwarded-For header we trust (reverse proxies). For local dev
# behind the Vite/nginx proxies leave empty so the socket peer is used directly.
# In production behind Vercel/Render/Cloudflare set this to the proxy IPs or
# CIDR blocks, otherwise every user shares one rate-limit key.
TRUSTED_PROXIES=

# Send the auth/CSRF cookies only over HTTPS. MUST be true in production (HTTPS)
# and false for local HTTP development. The frontend must be served over HTTPS
# whenever this is true.
COOKIE_SECURE=false

# Uploaded log constraints
MAX_UPLOAD_SIZE_MB=5
MAX_UPLOAD_LINES=5000

# --- Security Assistant (optional) ---
# The assistant is read-only and can only see the caller's own records. It is
# disabled by default; it needs both AI_ENABLED=true and the key for the
# selected provider. The key is read by the backend only — never expose it via
# VITE_* variables. There is no automatic fallback between providers.
#
# AI_PROVIDER=openai  -> reads AI_API_KEY and AI_MODEL
# AI_PROVIDER=gemini  -> reads GEMINI_API_KEY and GEMINI_MODEL
# Any other value fails closed with 503 and never reaches a provider.
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# Google Gemini. Only used when AI_PROVIDER=gemini. The default model is
# available on the Gemini free tier; check Google's current model list before
# changing it. Set to an empty value to fail closed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Per-user assistant request budget ("N/second", "N/minute", "N/hour"; 0 disables)
AI_RATE_LIMIT=20/minute

# Hard ceilings enforced by the backend on every request
AI_MAX_TOOL_CALLS=8
AI_MAX_CONTEXT_RECORDS=20
AI_MAX_MESSAGE_LENGTH=2000
AI_MAX_OUTPUT_TOKENS=800
AI_MAX_TOOL_RESULT_CHARS=8000
AI_REQUEST_TIMEOUT_SECONDS=20

# --- Frontend ---
# Target backend for the Vite dev server proxy
VITE_API_TARGET=http://localhost:8000